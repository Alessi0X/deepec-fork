# Dockerfile for testing legacy version with original dependencies
FROM --platform=linux/amd64 continuumio/miniconda3:4.12.0

WORKDIR /app

# Install git and clone the original repo
RUN apt-get update
RUN apt-get install -y git
RUN git clone https://bitbucket.org/kaistsystemsbiology/deepec.git .
RUN rm -rf .git

# Create conda environment from the original environment.yml
RUN conda env create -f environment.yml
RUN conda clean -afy
RUN conda clean --all --yes

WORKDIR /data

# The entrypoint will run deepec from the conda environment
ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "deepec", "python", "/app/deepec.py"]
